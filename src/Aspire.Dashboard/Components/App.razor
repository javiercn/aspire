<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-ui-variant="@Aspire.Dashboard.Model.ThemeState.Variant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="aspire-version" content="@VersionHelpers.DashboardDisplayVersion" />
    <meta name="dotnet-runtime-version" content="@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription" />
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    @* All dashboard stylesheets load through this entry so they can be ordered into cascade layers
       (base vs github overlay). See css/aspire-layers.css. *@
    <link rel="stylesheet" href="css/aspire-layers.css" />

    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <!-- Make the body background dark if dark mode will be enabled to prevent a flash of white
         before fully rendered. GitHub variant uses the Primer dark canvas; Fluent variant uses the
         classic neutral-layer-2 color. -->
    <style>
        @@media (prefers-color-scheme: dark) {
            body {
                background-color: @(Aspire.Dashboard.Model.ThemeState.UseGitHubUI ? "#0d1117" : "#272727");
            }
        }
    </style>

</head>

<body class="before-upgrade">
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <ReconnectModal />
    <BlazorScript />
    <script src="js/app.js"></script>
    <script src="js/app-reconnect.js"></script>

    @*
        Directly reference theme and dependencies from HTML so they load quickly.
        It's much faster to load them here than wait for module load from Blazor interop.
        Load time is important here because the theme should be applied ASAP.
    *@
    <script src="js/app-theme.js" type="module"></script>
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js" type="module"></script>
</body>
</html>
